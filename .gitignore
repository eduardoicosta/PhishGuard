# ==========================================
# FIAP ENTERPRISE CHALLENGE - PHISHGUARD
# Arquivo .gitignore Completo e Estruturado
# ==========================================

# 1. Bloqueio de Arquivos Pesados do Projeto (Obrigatório)
# -------------------------------------------------------------------------
data/
models/
*.csv
*.pkl

# 2. Ambientes Virtuais (Virtual Environments)
# -------------------------------------------------------------------------
venv/
ENV/
env/
.venv/
env.bak/
venv.bak/

# 3. Configurações Locais e Credenciais Secretas (Segurança)
# -------------------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.bak
*.secret

# 4. Arquivos Temporários e Caches do Python
# -------------------------------------------------------------------------
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 5. Caches de Testes e Ferramentas de Qualidade
# -------------------------------------------------------------------------
.pytest_cache/
.tox/
.nox/
.coverage
.cache
htmlcov/
.mypy_cache/
.ruff_cache/

# 6. Configurações de IDEs (VS Code, PyCharm, etc.) e Sistema Operacional
# -------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Arquivos de sistema (Windows e macOS)
Thumbs.db
db.ini
ehthumbs.db
Desktop.ini
.DS_Store
.AppleDouble
.LSOverride