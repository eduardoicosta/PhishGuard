# PhishGuard — variáveis de ambiente.
# Copie para `.env` e preencha. NUNCA versione o .env real.

# --- Obrigatórias ----------------------------------------------------------

# Chave da API do Google Gemini (Camada 2 / análise contextual).
# Sem ela a API sobe, mas opera apenas com a Camada 1 (estatística).
GEMINI_API_KEY=

# String de conexão do PostgreSQL (Azure Database for PostgreSQL).
# Guarda SOMENTE metadados agregados — nunca conteúdo de mensagens.
# Ausente: a análise continua funcionando e a telemetria é desativada.
DATABASE_URL=

# --- Privacidade e conformidade (LGPD) -------------------------------------

# Sal do HMAC-SHA256 usado para pseudonimizar contas e organizações
# (Art. 13, §4). Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Em produção, mantenha em um cofre (Azure Key Vault), não no arquivo.
# Se ausente, um sal efêmero é gerado por processo: os hashes deixam de ser
# estáveis entre reinícios e as métricas por usuário se fragmentam.
PHISHGUARD_SAL_PSEUDONIMO=

# Contato do Encarregado de Dados (DPO) exibido no manifesto público.
PHISHGUARD_DPO_CONTATO=dpo@phishguard.com.br

# --- Governança ------------------------------------------------------------

# Token exigido no cabeçalho X-PhishGuard-Token pelos endpoints corporativos
# (/api/metricas/corporativo, /api/logs-soc, /api/privacidade/auditoria).
# Se ausente, esses endpoints ficam abertos — aceitável apenas em desenvolvimento.
PHISHGUARD_ADMIN_TOKEN=

# --- Ajustes opcionais -----------------------------------------------------

# Limiar de decisão da Camada 1 quando a Camada 2 não está disponível.
PHISHGUARD_LIMIAR_CAMADA_1=0.35

# Modelo e resiliência da Camada 2.
PHISHGUARD_GEMINI_MODEL=gemini-3.5-flash
PHISHGUARD_GEMINI_TIMEOUT=12
PHISHGUARD_GEMINI_TENTATIVAS=2

# Pool de conexões do PostgreSQL.
PHISHGUARD_DB_POOL_MIN=1
PHISHGUARD_DB_POOL_MAX=8

# Origens extras liberadas no CORS (separadas por vírgula). Extensões de
# navegador e localhost já são aceitos por padrão.
PHISHGUARD_CORS_ORIGENS=

# Nível de log (DEBUG, INFO, WARNING, ERROR).
PHISHGUARD_LOG_LEVEL=INFO
